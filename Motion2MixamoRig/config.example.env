# 动补产线本机配置模板
# 复制为 config.env 再改成你机器上的路径;config.env 不入库。
# 解析顺序:环境变量 > 本文件 > 当前工作目录向上查找。

# 引用库根目录(只读,不改它)
MOTION2MIXAMO_HOME=H:\aiworks\motionPrj\Motion2MixamoRig

# 跑引用库的 Python(要装好 torch cu128 / gvhmr 的环境);留空则自动用 <HOME>/.venv
MOTION2MIXAMO_PYTHON=

# 素材与角色(相对路径按引用库根解析)
MOTION2MIXAMO_ASSETS_VIDEO=assets/video
MOTION2MIXAMO_DEFAULT_RIG=assets/mixamo/X_Bot.fbx

# 交付根目录;留空则用主工程 outputs/video_cap
MOTION2MIXAMO_OUTPUT_ROOT=

# 相机焦距(像素)。手机主摄 26mm @1920 宽约 1387;留空则上游按 43mm 启发式
MOTION2MIXAMO_FOCAL_PIXELS=

# 或者填"人到相机的距离"(米):本入口会用 YOLO 量人的像素身高,按
#   焦距 = 像素身高 × 距离 / 真人身高
# 反推焦距。优先级:焦距 > 距离 > 启发式。
MOTION2MIXAMO_DISTANCE_METRES=
# 画面里那个人的真实身高(米),把距离换算成焦距时用;默认 1.70
MOTION2MIXAMO_PERSON_HEIGHT_METRES=1.70

# Blender 可执行文件(导出 FBX / 渲染对照帧用)
BLENDER_EXECUTABLE=H:\Program Files\blender-5.2.0-x64\blender.exe

# ffmpeg / ffprobe(读时长、合成对比视频)。留空则在 PATH 里找,找不到会明确报错
MOTION2MIXAMO_FFMPEG=
MOTION2MIXAMO_FFPROBE=
